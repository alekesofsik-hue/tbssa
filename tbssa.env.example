# Copy to .env and fill secrets:
# cp tbssa.env.example .env
# chmod 600 .env

# ─── Core bot tokens ───────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN is required for the main runtime.
# MAX_BOT_TOKEN is optional; when set, MAX runs alongside Telegram.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=

# ─── MAX runtime ───────────────────────────────────────────────────────────────
MAX_BASE_URL=https://platform-api.max.ru
MAX_POLL_TIMEOUT=30
MAX_POLL_LIMIT=100

# ─── Database (optional override) ──────────────────────────────────────────────
# DB_URL=sqlite+aiosqlite:////path/to/tbssa/data/tbssa.db

# ─── Bootstrap / seed only ─────────────────────────────────────────────────────
# After bootstrap these values are mostly stored in DB and edited via bot admin UI.
# ADMIN_IDS and MAX_ADMIN_IDS are used only to create the initial admin set.
ADMIN_IDS=
MAX_ADMIN_IDS=
SSH_HOST=
SSH_USER=bot-admin
SSH_KEY_PATH=~/.ssh/id_ed25519_bot
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts
SSH_HOST_KEY_FINGERPRINT=
SSH_CONNECT_TIMEOUT=8
SSH_COMMAND_TIMEOUT=15
PING_HOST=
PING_COUNT=3
PING_TIMEOUT=1
CONFIRM_TTL_SECONDS=60
