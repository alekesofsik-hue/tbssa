# Скопируйте в .env и заполните. chmod 600 .env
# cp tbssa.env.example .env

# ─── Обязательно для запуска бота ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Только для первоначального seed (tbssa-seed). После bootstrap можно удалить
#     — данные уже в БД и редактируются через /admin ───────────────────────────
ADMIN_IDS=
SSH_HOST=
SSH_USER=bot-admin
SSH_KEY_PATH=~/.ssh/id_ed25519_bot
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts
SSH_HOST_KEY_FINGERPRINT=
SSH_CONNECT_TIMEOUT=8
SSH_COMMAND_TIMEOUT=15
PING_HOST=
PING_COUNT=3
PING_TIMEOUT=1
CONFIRM_TTL_SECONDS=60
