[Unit]
Description=Telegram Bot - Server Supervisor (tbssa)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/tbssa

EnvironmentFile=/path/to/tbssa/.env
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 -m tbssa
Restart=always
RestartSec=5
TimeoutStopSec=15

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# CAP_NET_RAW required for subprocess ping (ICMP)
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
UMask=0077

ReadOnlyPaths=/home/YOUR_USER/.ssh/id_ed25519_bot /home/YOUR_USER/.ssh/known_hosts

[Install]
WantedBy=multi-user.target
